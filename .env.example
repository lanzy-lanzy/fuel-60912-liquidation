# Django
DJANGO_SECRET_KEY=change-me-to-a-strong-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app

# Database - Supabase Postgres
# Get from Supabase Dashboard: Project Settings > Database > Connection string (pooler or direct)
# Pooler (recommended for serverless Vercel): use port 6543, requires ?pgbouncer=true
# Example: postgres://postgres.PROJECT_ID:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgres://postgres:password@db.supabase.co:5432/postgres?sslmode=require
# Alternative direct
# SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres

# Vercel (auto-set)
# VERCEL_URL is auto-set by Vercel, VERCEL=1 auto-set
